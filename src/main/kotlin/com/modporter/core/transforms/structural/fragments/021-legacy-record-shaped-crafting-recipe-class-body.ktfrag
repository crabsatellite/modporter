    private fun rewriteJavaNew(
        source: String,
        className: String,
        transform: (args: List<String>) -> String?
    ): String =
        rewriteExecutableJavaNew(source, className, transform)

    private fun rewriteExecutableJavaNew(
        source: String,
        className: String,
        transform: (args: List<String>) -> String?
    ): String {
        var result = source
        var cursor = 0
        val token = "new $className("
        while (true) {
