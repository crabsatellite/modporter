        result = replaceExecutableRegex(
            result,
            Regex("""new\s+([A-Za-z_$][\w$]*(?:\.[A-Za-z_$][\w$]*)*\.Instance)\(\s*ContextAwarePredicate\.ANY\s*\)""")
        ) { match ->
