        assertTrue(transformed.contains("public final Ingredient damagedItem(Item item)"), transformed)
        assertTrue(
            transformed.contains("DataComponentIngredient.of(false, DataComponents.DAMAGE, item.getMaxDamage(), item)"),
            transformed
