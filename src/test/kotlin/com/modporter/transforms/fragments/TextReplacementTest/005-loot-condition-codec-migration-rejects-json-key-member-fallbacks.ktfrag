                    }
                }
            }
        """.trimIndent())

        val db = MappingDatabase.loadDefault()
        val pass = TextReplacementPass(db)
        val result = pass.apply(projectDir)

        val transformed = projectDir.resolve("src/main/java/com/example/TestMod.java").readText()

