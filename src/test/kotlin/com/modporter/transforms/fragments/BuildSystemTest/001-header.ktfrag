                    name 'Tama Maven'
                    url "https://maven.tamaized.com/releases"
                }
                maven {
                    name 'Curseforge Maven'
                    url "https://www.cursemaven.com"
                    content {
                        includeGroup "curse.maven"
                    }
                }
            }
        """.trimIndent())

        val result = pass.apply(projectDir)
