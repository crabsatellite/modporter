                    public static void renderTick(RenderFrameEvent.Post event) {
                        if (event.phase == TickEvent.Phase.START) {
                            render();
                        }
                    }
                    ${"\"\"\""};

                public static void renderTick(RenderFrameEvent.Post event) {
