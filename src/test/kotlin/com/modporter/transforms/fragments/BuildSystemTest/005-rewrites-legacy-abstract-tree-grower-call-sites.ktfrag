        assertTrue(material.contains("ResourceLocation.fromNamespaceAndPath(com.example.TestMod.ID, textureName)"))
        assertTrue(mod.contains("ExampleArmorMaterials.ARMOR_MATERIALS.register(modEventBus);"))
