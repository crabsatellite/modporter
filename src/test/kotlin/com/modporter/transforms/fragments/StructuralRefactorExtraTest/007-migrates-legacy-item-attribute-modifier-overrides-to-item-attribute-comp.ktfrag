                    builder.put(NeoForgeMod.ENTITY_REACH.get(), new AttributeModifier(net.minecraft.resources.ResourceLocation.fromNamespaceAndPath("example", "entity_reach"), 1.0D, AttributeModifier.Operation.ADD_VALUE));
