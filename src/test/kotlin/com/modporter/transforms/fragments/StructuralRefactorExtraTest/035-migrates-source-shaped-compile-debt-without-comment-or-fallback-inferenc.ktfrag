                public void copied(GuiGraphics guiGraphics, Gui.HeartType heartType, int x, int y, boolean halfHeart, boolean blink) {
                    guiGraphics.blit(HEARTS, x, y, heartType.getX(halfHeart, blink), 0, 9, 9);
