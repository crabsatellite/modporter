                @Override
                public CompoundTag save(CompoundTag tag) {
                    CompoundTag podTag = new CompoundTag();
                    for (Map.Entry<BlockPos, PodData> entry : pods.entrySet()) {
                        podTag.put(entry.getKey().toString(), entry.getValue().save(new CompoundTag()));
                    }
                    return tag;
                }

