        assertTrue(result.errors.isEmpty(), "errors=${result.errors}")
        assertTrue(dispenser.contains("stack.hurtAndBreak(1, level, null, item -> {})"))
        assertTrue(dispenser.contains("if (this.isSuccess())"))
