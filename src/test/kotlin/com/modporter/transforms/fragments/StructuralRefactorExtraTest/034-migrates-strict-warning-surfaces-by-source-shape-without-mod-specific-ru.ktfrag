        """.trimIndent())
        srcDir.resolve("ConstructorAccessorSurface.java").writeText("""
            package com.example;

            public class ConstructorAccessorSurface {
                private final Object part;

                public ConstructorAccessorSurface() {
                    this.part = getRoot().getChild("part");
                }

                public Root getRoot() {
                    return new Root();
