                public static final DeferredHolder<PlacementBanRecipeSerializer<ItemStack, Ingredient, ItemBanRecipe>, PlacementBanRecipeSerializer<ItemStack, Ingredient, ItemBanRecipe>> ITEM_PLACEMENT_BAN = null;
