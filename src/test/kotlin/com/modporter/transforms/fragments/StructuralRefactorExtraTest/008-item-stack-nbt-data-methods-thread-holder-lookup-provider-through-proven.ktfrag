                    graphics.renderTooltip(Minecraft.getInstance().font, stack.getTooltipLines(Minecraft.getInstance().player, TooltipFlag.NORMAL), stack.getTooltipImage(), x, y);
                    reportName.moveCursorToStart();
                    reportName.tick();
