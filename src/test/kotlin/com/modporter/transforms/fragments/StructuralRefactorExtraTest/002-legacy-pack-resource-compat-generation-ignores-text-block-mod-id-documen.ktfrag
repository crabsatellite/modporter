
    @Test
    fun `legacy pack resource compat generation ignores text block mod id documentation`() {
        val srcDir = tempDir.resolve("src/main/java/com/example")
        srcDir.createDirectories()
        srcDir.resolve("ExampleMod.java").writeText(listOf(
            "package com.example;",
            "",
            "public final class ExampleMod {",
            "    String docs() {",
            "        return \"\"\"",
            "            @Mod(\"examplemod\")",
            "            public static final String MODID = \"examplemod\";",
            "            \"\"\";",
            "    }",
            "}",
            ""
        ).joinToString(System.lineSeparator()))
        srcDir.resolve("PackSetup.java").writeText("""
            package com.example;

            import java.nio.file.Path;
            import net.neoforged.neoforge.resource.PathPackResources;

            public class PackSetup {
                public PathPackResources open(Path sourcePath) {
                    return new PathPackResources("example:" + sourcePath, true, sourcePath);
                }
            }
        """.trimIndent())

        val result = StructuralRefactorPass().apply(tempDir)
        val setup = srcDir.resolve("PackSetup.java").readText()

        assertTrue(
            result.errors.any {
                it.contains("Legacy pack resource API migration error") &&
                    it.contains("Cannot derive generated compat package")
            },
            "Expected text block mod id documentation to be ignored; got: ${result.errors}"
        )
        assertFalse(setup.contains("com.modporter.generated.examplemod"), setup)
        assertFalse(tempDir.resolve("src/main/java/com/modporter/generated/examplemod/compat/PathPackResources.java").exists())
        assertFalse(result.changes.any { it.ruleId == "struct-generate-path-pack-resources" })
    }

    @Test
    fun `legacy pack resource compat generation rejects same file multiple mod ids`() {
        val srcDir = tempDir.resolve("src/main/java/com/example")
        srcDir.createDirectories()
        srcDir.resolve("CombinedMods.java").writeText("""
            package com.example;

            import net.neoforged.fml.common.Mod;

            @Mod(FirstMod.MOD_ID)
            class FirstMod {
                public static final String MOD_ID = "firstmod";
            }

            @Mod(SecondMod.MOD_ID)
            class SecondMod {
                public static final String MOD_ID = "secondmod";
            }
        """.trimIndent())
        srcDir.resolve("PackSetup.java").writeText("""
            package com.example;

            import java.nio.file.Path;
            import net.neoforged.neoforge.resource.PathPackResources;

            public class PackSetup {
                public PathPackResources open(Path sourcePath) {
                    return new PathPackResources("example:" + sourcePath, true, sourcePath);
                }
            }
        """.trimIndent())

        val result = StructuralRefactorPass().apply(tempDir)
        val setup = srcDir.resolve("PackSetup.java").readText()

        assertTrue(
            result.errors.any {
                it.contains("Legacy pack resource API migration error") &&
                    it.contains("Cannot derive generated compat package")
            },
            "Expected ambiguous same-file mod ids to hard gate; got: ${result.errors}"
        )
        assertFalse(setup.contains("com.modporter.generated.firstmod"), setup)
        assertFalse(setup.contains("com.modporter.generated.secondmod"), setup)
        assertFalse(tempDir.resolve("src/main/java/com/modporter/generated/firstmod/compat/PathPackResources.java").exists())
        assertFalse(tempDir.resolve("src/main/java/com/modporter/generated/secondmod/compat/PathPackResources.java").exists())
        assertFalse(result.changes.any { it.ruleId == "struct-generate-path-pack-resources" })
    }

